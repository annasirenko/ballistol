{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.section-{{ section.id }}-padding h2{font-size: 40px; font-weight: 400;line-height: 66px;letter-spacing: 1px;text-align: center;margin: 0 0 30px;} 
.media_data-cover{max-width:870px; margin:0 auto;}  
.media_data-cover-item img{max-width:100%;}
.media_data-cover-item{ width:50%; padding:0 20px; text-align: center;} 
.media_data-cover-item a {  text-decoration: none;}  
.media_data-cover-item h3 {  font-family: var(--font-body-family);  font-weight: bold !important;  font-size: 25px;  color: #00A113;  text-decoration: underline; margin: 0; padding: 7px 0;}

@media(max-width:767px){
.section-{{ section.id }}-padding h2{margin: 0 0 20px;}  
.media_data-cover-item{ width:100%; padding:0 0px 25px; text-align: center;} 
.media_data-cover .media_data-cover-item:last-child{padding-bottom:0;}  
}
  
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient" id="data-sheet">
  <div class="section-{{ section.id }}-padding">

<div class="page-width">
  {% if section.settings.title != blank %}
<h2>{{ section.settings.title }}</h2>
  {% endif %}
<div class="media_data-cover flex flex-flow" >

  
    {%- for block in section.blocks -%}
  <div class="media_data-cover-item">

            {% if block.settings.image != blank %}
             <a href="{{ block.settings.link }}" target="_blank">  
               <img src="{{ block.settings.image | img_url:'master' }}">  
             </a>
           {% endif %}
                {%- if block.settings.title != blank -%}
                 <a href="{{ block.settings.link }}" target="_blank">      <h3>{{ block.settings.title }}</h3> </a>
                {%- endif -%}

  </div>
    {%- endfor -%}
</div>
  
</div>
    
  </div>
</div>

{% schema %}
{
  "name": "Media Data sheet",
  "tag": "section",
  "class": "section",
  "settings": [
     {
     "type": "inline_richtext",
     "id": "title",
     "default": "PRODUCT DATA SHEETS",
     "label": "t:sections.multicolumn.blocks.column.settings.title.label"
     },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
    "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Column",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Data sheet"
    }
  ]
}
{% endschema %}
