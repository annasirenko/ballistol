{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }


  .section-{{ section.id }}-padding .media_video_loop ul li{
     width: calc(100% / 4);
    list-style: none;
    padding: 0 30px 40px; 
}
.section-{{ section.id }}-padding .media_video_loop ul li .video-section {
    height: 100%;
    padding: 0;
}
.section-{{ section.id }}-padding .media_video_loop .video-section__poster img{
position:static !important; 
}

.section-{{ section.id }}-padding .media_video_loop ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -30px;
    padding: 0;
}
.section-{{ section.id }}-padding .media_video_loop ul li .video-section iframe {
    height: 100%;
}

.section-{{ section.id }}-padding .media_video_loop ul li .video-section .video-section__media {
    height: 100%;
}
.section-{{ section.id }}-padding .media_vid_content h3 {
    margin: 0;
    font-size: 20px;
    line-height: 16px;
    display: table;
    border-bottom: #000 solid 1px;
    padding-top: 20px;
}

.section-{{ section.id }}-padding .media_video_loop ul li {
    display: flex;
    flex-direction: column;
}

.section-{{ section.id }}-padding .media_vid_content {
    font-weight: 500;
}



  
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.section-{{ section.id }}-padding h2{font-size: 40px; font-weight: 400;line-height: 66px;letter-spacing: 1px;text-align: center;margin: 0 0 30px;} 

@media(max-width:1100px){
.section-{{ section.id }}-padding .media_video_loop ul {
    margin: 0;
}

.section-{{ section.id }}-padding .media_video_loop ul li {
    padding: 0 15px 40px;
}
}
  
@media(max-width:767px){
.section-{{ section.id }}-padding h2{margin: 0 0 20px;}  
.section-{{ section.id }}-padding .media_video_loop ul li {
    width: 100%;
    padding: 0 0 20px;
}

.section-{{ section.id }}-padding .media_video_loop ul li .video-section {
    width: 100%;
}
 .section-{{ section.id }}-padding .video-section__media {
    border-radius: 15px!important;
  }
}
 
{%- endstyle -%}
<div id="{{ section.settings.page-id }}">
  <div class="color-{{ section.settings.color_scheme }} gradient"  id="video_media">
    <div class="section-{{ section.id }}-padding">
      <div class="page-width">
      {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
      {% endif %}
        <div class="media_video_loop">
          <ul>
            {% for block in section.blocks %}
            
             {% if block.settings.video_url != blank %}   
            <li>
            {% include 'img_video' %}
               <div class="media_vid_content">
                {% if block.settings.title != blank %}<h3 {% if section.settings.title_color %}style="color: {{ section.settings.title_color }}; border-color:  {{ section.settings.title_color }};"{% endif %}>{{ block.settings.title }}</h3> {% endif %}
                 {{ block.settings.content }}
               </div>
            </li>
            {% endif %}
            
            {% endfor %}
          </ul>
        
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Media Video",
  "tag": "section",
  "class": "section",
  "settings": [
  {
     "type": "inline_richtext",
     "id": "title",
     "default": "Video",
     "label": "t:sections.multicolumn.blocks.column.settings.title.label"
     },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    },
    {
      "type":"color",
      "id":"title_color",
      "label":"Video Title Color"
    }
  ],
		"blocks": [
          {
			"type": "video",
			"name": "Video",
			"settings": [
			  {
                "type": "checkbox",
                "id": "enable_video_looping",
                "label": "t:sections.video.settings.enable_video_looping.label",
                "default": false
              }, 
              {
                "type": "video_url",
                "id": "video_url",
                "accept": ["youtube", "vimeo"],
                "label": "t:sections.video.settings.video_url.label",
                "info": "t:sections.video.settings.video_url.info"
              },
              {
                "type": "image_picker",
                "id": "cover_image",
                "label": "t:sections.video.settings.cover_image.label"
              },
              {
                "type":"text",
                "id":"title",
                "label":"Title"
              },
              {
                "type":"richtext",
                "id":"content",
                "label":"Content"
              }
			]
		  }
		],
  "presets": [
    {
      "name": "Media Video"
    }
  ]
}
{% endschema %}
