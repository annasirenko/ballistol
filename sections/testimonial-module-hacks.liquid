{%- style -%}
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
.tst-module-main-inner {
    text-align: center;
}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.tst-module-topdiv h2{
font-size: 44px;
font-weight: 400;
line-height: 66px;   
margin: 15px 0 60px 0;
text-align: center;
}
.tst-module-slidrdiv img {
    max-width: 100%;     margin: 0 auto;
}
.tst-module-slidrdiv h3{font-size: 23px;font-weight: 500;line-height:1;letter-spacing: 0em;text-align: center;}
.tst-module-slidrdiv a{text-decoration:none;}


  .section-{{ section.id }}-padding button.slick-prev {left: 0px;}
  .section-{{ section.id }}-padding button.slick-next { right: 0px;}  
  .section-{{ section.id }}-padding .slick-arrow { position: absolute; top: 50%;background: transparent;  border: 0;  transform: translateY(-50%);}
.section-{{ section.id }}-padding .slick-arrow img{filter: brightness(0.9) invert(.7) sepia(.5) hue-rotate(100deg) saturate(200%);}
.section-{{ section.id }}-padding .tst-module-slider {  padding: 0 16px;}

@media screen and (min-width: 768px) {
.tst-module-slidrdiv {    opacity: 0.8; transform: scale(0.8);transition: all ease 0.5s;}
.tst-module-slidrdiv:hover{opacity: 1; transform: scale(1);}
.tst-module-slidrdiv:hover h3{font-size: 24px;font-weight: 700;line-height:1;}  

  
.slick-current.slick-active .tst-module-slidrdiv{ opacity: 1; transform: scale(1);}
.slick-current.slick-active .tst-module-slidrdiv h3{font-size: 24px;font-weight: 700;line-height:1;}    
}

@media screen and (max-width: 767px) {
.tst-module-topdiv h2 {    font-size: 26px;    font-weight: 700;    line-height: 34px;    margin: 15px 0 30px 0;}
.tst-module-slidrdiv h3{margin:0;padding:10px 0 0;}  
}
  
@media screen and (max-width: 500px) {


}

{%- endstyle -%}


<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">

    <div class="tst-module-main">
         <div class="page-width">
               <div class="tst-module-main-inner"> 
                  {% if section.settings.heading != blank %}  
                 <div class="tst-module-topdiv">
                 <h2>{{ section.settings.heading }}</h2>
                 </div>
                     {% endif %}
                     <div class="tst-module-slider">
                        {% for block in section.blocks %} 
                                 <div class="tst-module-slidrdiv">
                                   {% if block.settings.image != blank %}  <a href="{{ block.settings.button_link }}"> <img src="{{ block.settings.image | img_url:'master' }}"> </a> {% endif %}
                                   {% if block.settings.heading != blank %}  <a href="{{ block.settings.button_link }}">  <h3>{{ block.settings.heading }}</h3> </a> {% endif %}
                                 </div>
                        {% endfor %}
             
                     </div>
                 </div>
         </div>
      </div>
  </div>
</div>





{% schema %}
{
  "name": "Icon slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
     "type": "inline_richtext",
     "id": "heading",
     "default": "Talk about your brand",
     "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
      "blocks": [
    {
      "type": "slider",
      "name": "Slider",
      "settings": [
     {
      "type": "image_picker",
      "id": "image",
      "label": "Module image"
    },
    {
     "type": "inline_richtext",
     "id": "heading",
     "default": "Talk about your brand",
     "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
     "type": "url",
     "id": "button_link",
     "label": "Link"
    }  
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon slider"
    }
  ]
}
{% endschema %}


