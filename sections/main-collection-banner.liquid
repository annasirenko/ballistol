

{% if collection.metafields.custom.collection_banner != nil %}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }

.col_{{ section.id }}{ padding:60px 0;}
  .collection-hero__title {
  display: none;
}
.collection-hero__inner-meta-left{width:60%;}
.collection-hero__inner-meta-right{width:40%; padding-left:30px;}  
.collection-hero__inner-meta-right img{max-width:100%; display:block; margin-left: auto;} 
.collection-hero__icon{width:80px;}  
.collection-hero__inner-cover{padding:0 0 30px;}
  
.collection-hero__inner-cover img{max-width:100%; display:block;}
.collection-hero__inner-cover span {
  width: calc(100% - 80px);
  display: block;
  padding-left: 15px;
  font-size: 23px;
  letter-spacing: 0;
}

.collection-hero__inner-meta-left h3 {
  margin: 0;
  font-size: 55px;
  line-height: 1;
}
.collection-hero__inner-meta-left .metafield-rich_text_field{font-size:22px; max-width: 660px;}
  
@media screen and (max-width: 980px) {
  .collection-hero__icon{width:60px;} 
  .collection-hero__inner-cover span {  width: calc(100% - 60px);  font-size: 20px;}
.collection-hero__inner-meta-right img{width:100%;}
  .col_{{ section.id }}{ padding:40px 0;}
 .collection-hero__inner-meta-left{width:100%;}
.collection-hero__inner-meta-right{width:100%; padding:30px 0 0;}   
 .collection-hero__inner-meta-left h3 br{display:none;} 
}

@media screen and (max-width: 767px) {
   .collection-hero__inner-meta-left h3 { font-size: 40px;} 
  .collection-hero__inner-meta-left .metafield-rich_text_field{font-size:18px;}
}
{%- endstyle -%}




<div class=" color-{{ section.settings.color_scheme }} gradient col_{{ section.id }}">
   <div class="page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
     <div class="collection-hero__inner-meta flex flex-flow align-item-end">
        <div class="collection-hero__inner-meta-left">
<div class="collection-hero__inner-cover flex align-item-center">
         {% if  collection.metafields.custom.collection_banner.value.icon.value  != blank %}
        <div class="collection-hero__icon">  <img src="{{ collection.metafields.custom.collection_banner.value.icon.value | img_url: 'master' }}"></div>
        {% endif %}
  <span>{{ collection.title }}</span>
</div>

          
        {% if collection.metafields.custom.collection_banner.value.heading != blank %}  <h3>{{ collection.metafields.custom.collection_banner.value.heading }}</h3> {% endif %}
        {% if collection.metafields.custom.collection_banner.value.content != blank %}    {{ collection.metafields.custom.collection_banner.value.content | metafield_tag }}  {% endif %}
        </div>
       <div class="collection-hero__inner-meta-right">
          {% if  collection.metafields.custom.collection_banner.value.image.value  != blank %}
          <img src="{{ collection.metafields.custom.collection_banner.value.image.value | img_url: 'master' }}">
        {% endif %}
       </div>
     </div>
   </div>
</div>
{% endif %}  








{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} ">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt=""
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    }
  ]
}
{% endschema %}
