{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.map-cover-right img{max-width:100%;}

  
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">

<div class="page-width">

<div class="map-cover">
  <div class="map-cover-left">
<!-- Start Stockist.co widget -->
<div data-stockist-widget-tag="u18709">Loading store locator from <a href="https://stockist.co">Stockist store locator</a>...</div>
<script>
  (function(s,t,o,c,k){c=s.createElement(t);c.src=o;c.async=1;
  k=s.getElementsByTagName(t)[0];k.parentNode.insertBefore(c,k);
  })(document,'script','//stockist.co/embed/v1/widget.min.js');
</script> <!-- End Stockist.co widget -->
  
</div>

   <div class="map-cover-right">

     {% if section.settings.image != blank %}
         <img src="{{ section.settings.image | img_url:'master' }}">
      {% endif %}
   
 </div>
  
</div>
  

</div>
  
  </div>
</div>

<style>
  .stockist-map.stockist-map-leaflet{display:none;}
  .map-cover-right{display:none;}
  #stockist-widget .stockist-map {
  background-color: transparent;
}
 #stockist-widget .stockist-map img {
  width: 100%;

}

#stockist-widget .stockist-result-list ul > li {
  border-top: 1px solid #888888;
}
  
</style>
<script>
  $(document).ready(function(){
    var locatorLoad = setInterval(function(){
      if($(".stockist-map.stockist-map-leaflet").length && $(".map-cover-right").length){
        $(".stockist-map.stockist-map-leaflet").html($(".map-cover-right").html());
        $(".stockist-map.stockist-map-leaflet").show();
        clearInterval(locatorLoad);
      }
    },500);
  });
</script>

{% schema %}
{
  "name": "Map",
  "tag": "section",
  "class": "section",
  "settings": [
    {
     "type": "image_picker",
     "id": "image",
     "label": "t:sections.multicolumn.blocks.column.settings.image.label"
    }, 
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Map"
    }
  ]
}
{% endschema %}
