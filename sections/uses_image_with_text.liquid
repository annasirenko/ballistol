{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient" id="{{ section.settings.page-id }}">
  <div class="section-{{ section.id }}-padding">
    <div class="page-width">
      
    <div class="use_img_text">
   {% if section.settings.img_green != blank or section.settings.title != blank or section.settings.detail != blank %}
      <div class="green_header">
        {% if section.settings.img_green != blank %}
          <div class="green_img">
            <img src="{{ section.settings.img_green | img_url:"master" }}" alt=""/>
          </div>
          {% endif %}
          <div class="green_text">
          {% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}
          {% if section.settings.detail != blank %}<p>{{ section.settings.detail }}</p>{% endif %}
          </div>        
      </div>
   {% endif %}
   
      {% if section.settings.content != blank %}
      <div class="uses_content">
        {{ section.settings.content }}
      </div>
      {% endif %}


      <div class="uses_text_cover">
        <ul>
          {% for block in section.blocks %}
          <li class="{% unless block.settings.use_img != blank %}use_text_only {% endunless %}">
            
            {% if block.settings.use_img != blank %}
            <div class="use_item_img">
              <img src="{{ block.settings.use_img | img_url:"master" }}" alt=""/>
            </div>
              {% endif %}

            <div class="use_item_text">
              {% if block.settings.title != blank %}
                <div class="use_title">{{ block.settings.title }}</div>
              {% endif %}
              {% if block.settings.use_content != blank %}
                <div class="use_content">
                  {{ block.settings.use_content }}
                </div>
              {% endif %}
            </div>

            
          </li>
          {% endfor %}
        </ul>
      </div>



      
    </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Uses Image With Text",
  "tag": "section",
  "class": "section uses_image_with_text",
  "settings": [
     {
      "type": "text",
      "id": "page-id",
      "label": "id"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom-liquid.settings.custom_liquid.label",
      "info": "t:sections.custom-liquid.settings.custom_liquid.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    },
    {
      "type": "image_picker",
      "id": "img_green",
      "label": "Green Image"
    },
    {
      "type":"text",
      "id":"title",
      "label":"Green Title"
    },
    {
      "type":"textarea",
      "id":"detail",
      "label":"Green Detail"
    },
    {
      "type":"richtext",
      "id":"content",
      "label":"Content"
    }
  ],
		"blocks": [ 
		  {
			"type": "image",
			"name": "Image Text",
			"settings": [
			  {
				"type": "image_picker",
				"id": "use_img",
				"label": "Image"
			  },
			  {
				"type": "text",
				"id": "title",
				"label": "Title"
			  },
			  {
				"type": "richtext",
				"id": "use_content",
				"label": "Content"
			  }
			]
		  } 
		],
  "presets": [
    {
      "name": "Uses Image With Text"
    }
  ]
}
{% endschema %}
