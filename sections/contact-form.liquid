{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.contact-form-cover-left{width:50%; padding:0 15px;   font-size: 20px;  line-height: normal;}
.contact-form-cover-left a{color:{{ section.settings.text-color }}; text-decoration: none;} 
.contact-form-cover-left h4{color:{{ section.settings.text-color }}; font-weight:400; font-size:30px; padding: 0; margin:0;}  
.contact-form-cover-right{width:50%; padding:0 15px;}  
  #ContactForm{background:#D9D9D9; padding:20px 30px; border-radius:15px;}

.field-cover input {
  padding: 0px 16px !important;
}
.title.title-wrapper--no-top-margin {
  margin: 0;
  padding: 0 0 10px;
  text-align: center;
}

.contact-form-cover-right #ContactForm-body {
  height: 194px;
}

.styled-checkbox {
  position: absolute;
  opacity: 0;
}
.styled-checkbox + label {
  position: relative;
  cursor: pointer;
  padding: 0;
}
.styled-checkbox + label:before {
  content: "";
  margin-right: 10px;
  display: inline-block;
  vertical-align: text-top;
  width: 34px;
  height: 34px;
  background: white; box-shadow: 0 0 0 1px rgba(0, 0, 0, 1);
}


.styled-checkbox:checked + label:before {
  background: #000;
}

.styled-checkbox:checked + label:after {
  content: "";
  position: absolute;
left: 12px;
top: 20px;
  background: white;
  width: 2px;
  height: 2px;
  box-shadow: 2px 0 0 white, 4px 0 0 white, 4px -2px 0 white, 4px -4px 0 white, 4px -6px 0 white, 4px -8px 0 white;
  transform: rotate(45deg);
}

.contact__button-cover-left{width:200px;}
.contact__button-cover-left span{display:block; line-height:1.3;}
.contact__button-right {  width: calc(100% - 200px);}
.contact__button-right button{background:{{ section.settings.bg }}; font-size: 22px;
font-weight: 600;
width: 100%;
display: block;
min-width: auto;
max-width: 210px; padding:11px 5px;
margin-left: auto;}  


@media(max-width:980px){
.contact-form-cover-left{width:100%; padding:0 0px;  }
.contact-form-cover-right{width:100%; padding:25px 0 0;}  
#ContactForm{padding:20px 20px;}  
}

@media(max-width:700px){  
.contact-form-cover-left h4{font-size:25px;}
.styled-checkbox + label::before {width:20px; height:20px;}  
.styled-checkbox:checked + label::after{left: 6px; top: 13px;}  
.contact__button-cover-left span {  font-size: 12px;}  
.contact__button-right button{font-size:17px;}  
}
  
  
{%- endstyle -%}

<div class="" style="background:{{ section.settings.bg }}">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
   
  
 <div class="contact-form-cover flex flex-flow align-item-center">   
    <div class="contact-form-cover-left" >
    <div class="rte" style="color:{{ section.settings.text-color }}">  {{ page.content }}</div>
    </div>  
   
     <div class="contact-form-cover-right">   


    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
 {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>

  {%- endif -%}
       
       
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {% render 'icon-success' %}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {% render 'icon-error' %}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#ContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}

   <div class="field-cover">
          <label class="field__label-c" for="ContactForm-name">Your Name:</label>
        <div class="field">
          <input
            class="field__input"
            autocomplete="name" required
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
          >
       
        </div>
  </div>

       <div class="field-cover">
          <label class="field__label-c" for="ContactForm-email"> Your Email:</label>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input contact__email__field"
            name="contact[email]"
            spellcheck="false" required
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
      
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                {%- render 'icon-error' -%}
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
  </div>

        <div class="field-cover">
                  <label class="field__label-c" for="ContactForm-body">
    Your Message:
   
        </label>
      <div class="field">
        <textarea
          rows="10"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
        >
          {{- form.body -}}
        </textarea>

      </div>
               </div>

     <div class="contact__button-cover flex align-item-center space-between">  
         
        <div class="contact__button-cover-left flex ">
{% comment %}
            <input class="styled-checkbox" id="newsletter-checkbox" type="checkbox" value="value1">
            <label for="newsletter-checkbox"></label>

          <span>Sign up to recieve special offers from Ballistol.</span>
          {% endcomment %}
        </div>  
      
      <div class="contact__button-right">
        <button type="submit" class="button contact-form-btn">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
      </div>


       
    {%- endform -%}
  </div>
  </div>
</div>
    
</div>

{% comment %}
<div style="display:none;">
  <form method="post" action="/contact#contact_form"  accept-charset="UTF-8" class="newsletter-form" >
    <input type="hidden" name="form_type" value="customer">
    <input type="hidden" name="utf8" value="✓">
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter-form__field-wrapper">
      <div class="field">
        <input id="NewsletterForm--template--14850291073068__newsletter" type="email" name="contact[email]" class="field__input email__field" value="" aria-required="true" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="Email" required="">
        <label class="field__label" for="NewsletterForm--template--14850291073068__newsletter">
          Email
        </label>
        <button type="submit" class="newsletter-form__button field__button" name="commit" id="Subscribe" aria-label="Subscribe">
        <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
          </path>
        </svg>
        </button>
      </div>
    </div>
  </form>
</div>

<script>
$(document).ready(function(){ 

  
  var form2 = $('.newsletter-form');   
  // Success function
   $(".contact-form-btn").click(function(e){
      e.preventDefault();
      var emailVal = $(".contact__email__field").val();
      if($("#newsletter-checkbox").is(":checked") && emailVal != ""){  
        form2.find(".email__field").val($(".contact__email__field").val());

        
        $.ajax({
            type: "POST",
            url: form2.attr('action'),
            cache: false,
             async: true,
            dataType: "json",
            data: $(this).serialize(),
            success: function(data){
              console.log("Thank's For Submitting Your Email");
              $("#ContactForm").submit();
            },
        });
      }else{
        $("#ContactForm").submit();
      }
  });  
}); 
</script>
{% endcomment %}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Contact form",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "t:sections.all.colors.label",
      "default": "#00A113"
    },
     {
      "type": "color",
      "id": "text-color",
      "label": "Left Content color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
