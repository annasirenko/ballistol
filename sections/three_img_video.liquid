{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="three_img_video_cover {% if section.settings.border_bottom %}border_bottom {% endif %}" id="{{ section.settings.page-id }}">
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="section-{{ section.id }}-padding">
       <div class="page-width">
        <div class="three_img_video_inner">
          
          {% if section.settings.img_green != blank or section.settings.title != blank or section.settings.detail != blank %}
          <div class="green_header">
            {% if section.settings.img_green != blank %}
              <div class="green_img">
                <img src="{{ section.settings.img_green | img_url:"master" }}" alt=""/>
              </div>
              {% endif %}
              <div class="green_text">
              {% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}
              {% if section.settings.detail != blank %}<p>{{ section.settings.detail }}</p>{% endif %}
              </div>        
          </div>
          {% endif %}

          <div class="image_video_block_content">

            <div class="img_video_loop">

              {% if section.settings.content_position_top %}
              {% if section.settings.content != blank %}
              <div class="img_video_detail">{{ section.settings.content  }}</div>
              {% endif %}
              {% endif %}
              
              <ul>
                 {% for block in section.blocks %}
                     {% case block.type %}
                      {%- when 'image' -%}
                         {% if block.settings.img != blank %}
                        <li>
                          <img class="{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" src="{{ block.settings.img | img_url:"master" }}"/>
                        </li>
                         {% endif %}
                         {%- when 'video' -%}
                    {% if block.settings.video_url != blank %}      
                        <li>
                          {% include 'img_video' %}
                        </li>
                    {% endif %}
                {% endcase %}
                {% endfor %}
              </ul>


              {% unless section.settings.content_position_top %}
              {% if section.settings.content != blank %}
              <div class="img_video_detail">{{ section.settings.content  }}</div>
              {% endif %}
              {% endunless %}

              
            </div>

           {% if section.settings.video_url != blank or section.settings.imgvideo1 != blank or section.settings.imgvideo2 != blank or section.settings.video_content != blank %}
            <div class="video_text_content {% if section.settings.image_first %} video_img_first {% endif %} 
                    {% if section.settings.video_url != blank and section.settings.imgvideo1 != blank %} one_item_content {% endif %}
               {% if section.settings.video_url != blank and section.settings.imgvideo2 != blank %} one_item_content {% endif %}
               {% if section.settings.imgvideo2 != blank and section.settings.imgvideo1 != blank %} one_item_content {% endif %} 
              ">
             {% if section.settings.video_content != blank %} <div class="video_text_bottom">{{ section.settings.video_content }}</div>{% endif %}
             {% if section.settings.video_url != blank or section.settings.imgvideo1 != blank or section.settings.imgvideo2 != blank %}
               <div class="video_part 
               {% if section.settings.video_url != blank and section.settings.imgvideo1 != blank %} two_item_box {% endif %}
               {% if section.settings.video_url != blank and section.settings.imgvideo2 != blank %} two_item_box {% endif %}
               {% if section.settings.imgvideo2 != blank and section.settings.imgvideo1 != blank %} two_item_box {% endif %} 
                 ">
                {% if section.settings.video_url != blank %}{% include 'normal_video' %}{% endif %}
               {% if section.settings.imgvideo1 != blank %}<img class="inner_bottom_part" src="{{ section.settings.imgvideo1 | img_url:"master" }}" alt=""/>  {% endif %}
               {% if section.settings.imgvideo2 != blank %}<img class="inner_bottom_part" src="{{ section.settings.imgvideo2 | img_url:"master" }}" alt=""/>  {% endif %}
             </div>
               {% endif %}
            </div>
          {% endif %}
            
          </div>

          
        </div> 
       </div>  
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three Image Video",
  "tag": "section",
  "class": "three_img_video",
  "settings": [ 
     {
      "type": "text",
      "id": "page-id",
      "label": "id"
    },
    {
      "type":"checkbox",
      "id":"border_bottom",
      "label":"Enable Border Bottom"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    },
    {
      "type": "image_picker",
      "id": "img_green",
      "label": "Green Image"
    },
    {
      "type":"text",
      "id":"title",
      "label":"Green Title"
    },
    {
      "type":"textarea",
      "id":"detail",
      "label":"Green Detail"
    },
    {
      "type":"header",
      "content":"Section Content"
    },
    {
      "type":"richtext",
      "id":"content",
      "label":"Content"
    },
    {
      "type":"checkbox",
      "id":"content_position_top",
      "label":"Enable Content Top Position"
    },
    {
      "type":"header",
      "content":"Video And Text"
    },
    {
      "type":"richtext",
      "id":"video_content",
      "label":"Video Content"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__1.content"
    }, 
    {
      "type": "header",
      "content": "t:sections.video.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"], 
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "checkbox",
      "id": "image_first",
      "label": "Enable Image First"
    },
    {
      "type":"image_picker",
      "id":"imgvideo1",
      "label":"Bottom Content Image 1"
    },
    {
      "type":"image_picker",
      "id":"imgvideo2",
      "label":"Bottom Content Image 2"
    }
  ],
		"blocks": [
		  {
			"type": "image",
			"name": "Image Text",
			"settings": [
			  {
				"type": "image_picker",
				"id": "img",
				"label": "Image"
			  }
			]
		  },
          {
			"type": "video",
			"name": "Video",
			"settings": [
			  {
                "type": "checkbox",
                "id": "enable_video_looping",
                "label": "t:sections.video.settings.enable_video_looping.label",
                "default": false
              },
              {
                "type": "header",
                "content": "t:sections.video.settings.header__1.content"
              },
              {
                "type": "header",
                "content": "t:sections.video.settings.header__2.content"
              },
              {
                "type": "paragraph",
                "content": "t:sections.video.settings.paragraph.content"
              },
              {
                "type": "video_url",
                "id": "video_url",
                "accept": ["youtube", "vimeo"],
                "label": "t:sections.video.settings.video_url.label",
                "info": "t:sections.video.settings.video_url.info"
              },
              {
                "type": "image_picker",
                "id": "cover_image",
                "label": "t:sections.video.settings.cover_image.label"
              }
			]
		  } 
		],
  "presets": [
    {
      "name": "Three Image Video"
    }
  ]
}
{% endschema %}
