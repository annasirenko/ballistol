{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.hero-banner-main img{max-width:100%; width:100%;}
.hero-banner-main video{max-width:100%; width:100%; display:block;}  
.hero-banner-main{position:relative;}
.hero-banner-main-caption {  text-align: center; margin: 20px auto 40px;    max-width: 100%;}
.hero-banner-main-caption-inner{max-width:568px; margin:0 auto;}
  
.hero-banner-main-caption h2{font-size: 76px;font-weight:700;line-height: 82px;margin: 0px 0 30px;}
.hero-banner-main-caption h2 a{color:{{section.settings.color_scheme.settings.text}}; text-decoration-thickness: 3px; text-underline-offset: 0.3rem;}  
.hero-banner-main-bottom{padding:0 0 20px;}  
.hero-banner-main-bottom p{font-size: 30px;font-weight: 600;line-height: 38px;text-align: center; max-width:1149px; margin:0 auto;color:#FFFCFC;}
.hero-banner-main-caption .button {    min-height: 91px;    padding: 0;    font-size: 40px;    width: 100%;    }
  

@media screen and (max-width: 1280px) {
  .hero-banner-main-caption h2{font-size: 60px; line-height: 72px}
}

@media screen and (max-width: 1200px) {
  .hero-banner-main-caption h2{font-size: 50px; line-height: 60px}
 .hero-banner-main-caption .button {     min-height: 71px;       font-size: 30px;      max-width: 270px;} 
.hero-banner-main-caption-inner {    max-width: 468px;}
}
  
  

@media screen and (min-width: 990px) {
.hero-banner-main-mobile{display:none !important;}
 }
  

@media screen and (max-width: 989px) {
.hero-banner-main-desktop{display:none !important;}
 .hero-banner-main-caption-inner {    max-width: 100%;}


.hero-banner-main-caption .button {    min-height:55px;    min-width:auto;    padding: 0;    font-size: 22px;    width: 100%;    }  


  
 }


@media screen and (max-width: 768px) {
  
}
  
@media screen and (max-width: 767px) {
.hero-banner-main-caption h2{font-size: 35px;margin: 0px 0 20px;line-height:1;}  
.hero-banner-main-bottom p{font-size: 18px;line-height:1.5}    
.hero-banner-main-bottom p{font-size: 20px;line-height: 26px;}  
}
  
  
{%- endstyle -%}


<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="hero-banner-main">
    


     {% if section.settings.image != blank %} 
   <video class="hero-banner-main-desktop" width="100%" playsinline="true" autoplay="autoplay" loop="loop" webkit-playsinline="true" muted="muted"    >
      <source src="{{ section.settings.image }}" type="video/mp4">
      <source src="{{ section.settings.image }}" type="video/ogg">
    </video>
       {% endif %}
     {% if section.settings.imagem != blank %} 
   <video class="hero-banner-main-mobile" width="100%" playsinline="true" autoplay="autoplay" loop="loop" webkit-playsinline="true" muted="muted"   >
      <source src="{{ section.settings.imagem }}" type="video/mp4">
      <source src="{{ section.settings.imagem }}" type="video/ogg">
    </video>
   {% endif %}

    
      <div class="hero-banner-main-caption">
         <div class="page-width">
               <div class="hero-banner-main-caption-inner">
        {% if section.settings.heading != blank %}    
        <h2>{{ section.settings.heading }}</h2>
          {% endif %}
       {% if section.settings.button_label != blank %}      <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>   {% endif %}
         </div>
                 </div>
      </div>
  </div>
   {% if section.settings.bottomcontent != blank %}
  <div class="hero-banner-main-bottom">
     <div class="page-width">
    <p>{{ section.settings.bottomcontent }}</p>
     </div>
  </div>
    {% endif %}
  
</div>





{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
     {
      "type": "text",
      "id": "image",
      "label": "Desktop image"
    },
     {
      "type": "text",
      "id": "imagem",
      "label": "Mobile image"
    },
    {
     "type": "inline_richtext",
     "id": "heading",
     "default": "Talk about your brand",
     "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
     "type": "inline_richtext",
     "id": "bottomcontent",
     "default": "Talk about your brand",
     "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
     {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_label_1.label",
          "info": "t:sections.rich-text.blocks.buttons.settings.button_label_1.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_link_1.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

