{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }


shop-ctgry-main-inner ul li img{max-width:100%;}  
.shop-ctgry-main .shop-heading h2{font-size: 36px;font-weight: 400;line-height: 66px;letter-spacing: 0em;text-align: center;margin: 0 0 30px;}
.shop-ctgry-main-inner ul{padding:0; margin:0; list-style:none;     grid-template-columns: 1fr 1fr 1fr;   gap:80px;  display: grid; }
.shop-ctgry-main-inner ul li {text-align: center;border-radius: 20px;padding: 40px 15px 27px;}  
 .shop-ctgry-main-inner ul li h3{font-size: 32px;font-weight: 400;line-height: 48px;letter-spacing: 0em;text-align: center;margin:0 0 21px 0;text-decoration:underline;}
 .shop-ctgry-main-inner ul li a{min-height:80px;  min-width:220px; font-size: 30px;font-weight: 500;line-height: 45px;letter-spacing: 0em;text-align: center;}
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width:1200px) { 
    .shop-ctgry-main-inner ul{  gap:20px;  }
.shop-ctgry-main-inner ul li {padding: 35px 15px;}    
 .shop-ctgry-main-inner ul li h3{font-size: 28px;line-height:38px;}
 .shop-ctgry-main-inner ul li a{min-height:60px;  min-width:200px; font-size:24px;line-height: 35px;}


    
  }
  @media screen and (max-width:1024px) {
 .shop-ctgry-main-inner ul li h3{font-size: 26px;line-height:28px;}    
  }
  

  
  @media screen and (max-width: 767px) {  
 .shop-ctgry-main-inner ul{ grid-template-columns: 1fr; }

  }
{%- endstyle -%}

<div class=" gradient section-{{ section.id }}-padding">
  <div class="shop-ctgry-main">
    <div class="page-width">
      <div class="shop-ctgry-main-inner">
        <div class="shop-heading">
          {% if section.settings.heading != blank %}    
        <h2>{{ section.settings.heading }}</h2>
          {% endif %}
        </div>
        <ul class="flex flex-flow space-between">
            {% for block in section.blocks %}
          
            <li class="color-{{ section.settings.color_scheme }}">
              {% if block.settings.image != blank %}    <img src="{{ block.settings.image | img_url:'master' }}">  {% endif %}
              {%- if block.settings.heading != blank -%}  <h3>{{ block.settings.heading }}</h3>     {%- endif -%}
               {%- if block.settings.button_label != blank -%}
                  <a class="button" href="{{ block.settings.button_link }}">    {{- block.settings.button_label | escape -}}</a>
                {%- endif -%}
            </li>
            
          {% endfor %}
          

        </ul>
      </div>
    </div>
    
  </div>
</div>






{% schema %}
{
  "name": "Shop By Category",
  "tag": "section",
  "class": "section",
  "settings": [

    {
     "type": "inline_richtext",
     "id": "heading",
     "default": "Talk about your brand",
     "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
    "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
      "type": "image_picker",
      "id": "image",
      "label": "image"
    },
    {
     "type": "inline_richtext",
     "id": "heading",
     "default": "Talk about your brand",
     "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
     "type": "text",
     "id": "button_label",
     "default": "Button label",
     "label": "t:sections.rich-text.blocks.buttons.settings.button_label_1.label",
     "info": "t:sections.rich-text.blocks.buttons.settings.button_label_1.info"
    },
    {
     "type": "url",
     "id": "button_link",
     "label": "t:sections.rich-text.blocks.buttons.settings.button_link_1.label"
    }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category"
    }
  ]
}
{% endschema %}


