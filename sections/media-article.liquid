{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.section-{{ section.id }}-padding h2{font-size: 40px; font-weight: 400;line-height: 66px;letter-spacing: 1px;text-align: center;margin: 0 0 30px;} 
.section-{{ section.id }}-padding .page-width{max-width:1200px;}
  
.media-article-cover{margin:0 -25px;}
.media-article-item{width:50%; margin:25px 0; padding:0 25px;}
.media-article-item-left img{display:block; width:100%;}
.media-article-item-right h3 a{ color:{{section.settings.color_scheme.settings.text }};   font-family: var(--font-body-family);  font-weight: bold !important;  font-size: 25px; }  
.media-article-item-left{width:153px;}
.media-article-item-right {  width: calc(100% - 153px);  padding-left: 19px;}
.media-article-item-right h3 {
  margin: 0;
  padding: 0 0 15px; 
}  
.media-article-item-right p{padding:0; margin:0; line-height: normal;}
  
@media(max-width:767px){
.section-{{ section.id }}-padding h2{margin: 0 0 20px;}  
}

@media(max-width:1024px){
.media-article-cover{margin:0 -10px;}
.media-article-item{width:50%; margin:20px 0; padding:0 10px;}
.media-article-item-right h3 a{font-size: 20px;}  
  
}

@media(max-width:980px){
.media-article-item-left{width:100px;}
.media-article-item-right {  width: calc(100% - 100px);  padding-left: 10px;}  
.media-article-item-right p{font-size:15px;}  
.media-article-item-right h3{padding:0 0 8px;}  
}

@media(max-width:767px){
.media-article-cover{margin:0 0px;}
.media-article-item{width:100%; margin:15px 0; padding:0 0px;}
.media-article-item-right h3 a{font-size: 17px;}    
}
  
  
  
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient" id="media_article">
  <div class="section-{{ section.id }}-padding">
    <div class="page-width">
       {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
     {% endif %}

    <div class="media-article-cover flex flex-flow" >
        {%- for block in section.blocks -%}
        <div class="media-article-item flex align-item-center">
            <div class="media-article-item-left ">
             {% if block.settings.image != blank %} <a href="{{ block.settings.link }}">  <img src="{{ block.settings.image | img_url:'master' }}"></a> {% endif %}
            </div>
            <div class="media-article-item-right">
            {% if block.settings.title != blank %}    <h3><a href="{{ block.settings.link }}">{{ block.settings.title }}</a></h3> {% endif %}
              {% if block.settings.text != blank %}  {{ block.settings.text }} {% endif %}
            </div>
        </div>
     {%- endfor -%}
  </div>
    
  </div>
</div>
</div>
<div id="pro-photos">&nbsp;</div>

{% schema %}
{
  "name": "Media Articles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "ARTICLES ABOUT BALLISTOL",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
   "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Column",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Articles"
    }
  ]
}
{% endschema %}
