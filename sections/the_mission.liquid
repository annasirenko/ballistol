

<div class="mission_image_cover">
<div class="text_image top_cover">
  <div class="page-width">
<div class="text_image inner_cover">
  <div class="the_mission_text">
    <h2 class="text_mission">{{ section.settings.heading }}</h2>
    <div class="mission_content">
      {{ section.settings.mission_content }}
     </div>
  
   </div>
  <div class="helmut_clever">
   {% if section.settings.img != blank %}<img src="{{ section.settings.img | img_url:"master" }}" alt="">{% endif %}
    <span>{{ section.settings.name }}</span>
  </div>
 </div>
  <div class="ballistor_text">
      <p>{{ section.settings.detail }}</p>
    </div>
  
</div>
</div>
</div>









{% schema %}
  {
    "name": "The Mission",
    "settings": [
      {
        "type":"text",
        "id":"heading",
        "label":"Heading"
      },
      {
        "type":"richtext",
        "id":"mission_content",
        "label":"Mission Content"
      },
      {
        "type":"image_picker",
        "id":"img",
        "label":"Image"
      },
      {
        "type":"text",
        "id":"name",
        "label":"Name"
      },
      {
        "type":"text",
        "id":"detail",
        "label":"Detail"
      }
    ],
    "presets":[
      {
        "name":"The Mission"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}